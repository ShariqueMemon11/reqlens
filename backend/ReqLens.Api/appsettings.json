{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=reqlens;Username=postgres;Password=postgres"
  },
  "Frontend": {
    "Origin": "http://localhost:5173"
  },
