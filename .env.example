# Frontend — copy into frontend/.env (Vite only loads env files from the frontend folder)
VITE_API_URL=http://localhost:5080

# Backend — set these via user secrets, not this file:
#   ConnectionStrings:Postgres
#   Llm:Groq:ApiKey
#   Llm:Gemini:ApiKey
# Optional:
#   Llm:Groq:Model=openai/gpt-oss-20b
#   Llm:Groq:Strict=true
#   Llm:Gemini:EmbeddingModel=gemini-embedding-001
# Contradiction candidate filter (appsettings.json, overridable via user secrets):
#   ContradictionDetection:NeighborsPerRequirement=5
#   ContradictionDetection:SimilarityThreshold=0.70
#   ContradictionDetection:MaxCandidatePairs=15
